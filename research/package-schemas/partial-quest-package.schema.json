{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zs99smz6wy-web/osrs-ironman-progression/research/package-schemas/partial-quest-package.schema.json",
  "title": "Research-only partial quest package",
  "type": "object",
  "required": ["package_schema_version", "package_type", "quest_id", "quest_name", "status", "scope", "sources", "requirements", "checkpoints", "completion", "boundaries"],
  "properties": {
    "package_schema_version": {"const": 1},
    "package_type": {"const": "research-only-partial-quest"},
    "quest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "quest_name": {"type": "string", "minLength": 1},
    "status": {"enum": ["research", "integration-reviewed"]},
    "scope": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "requirements": {"$ref": "#/$defs/requirements"},
    "checkpoints": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/checkpoint"}},
    "completion": {"$ref": "#/$defs/completion"},
    "boundaries": {"$ref": "#/$defs/boundaries"}
  },
  "additionalProperties": false,
  "$defs": {
    "source": {"type": "object", "required": ["id", "url", "used_for", "verified_at"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "url": {"type": "string", "format": "uri"}, "used_for": {"type": "string", "minLength": 1}, "verified_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}, "additionalProperties": false},
    "item": {"type": "object", "required": ["id", "quantity", "disposition"], "properties": {"id": {"type": "string", "minLength": 1}, "quantity": {"type": "integer", "minimum": 1}, "disposition": {"enum": ["required", "carried", "received", "consumed", "retained", "removed"]}}, "additionalProperties": false},
    "requirements": {"type": "object", "required": ["quests", "skills", "items", "gp", "other"], "properties": {"quests": {"type": "array", "items": {"type": "string"}}, "skills": {"type": "array", "items": {"type": "string"}}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "gp": {"type": "integer", "minimum": 0}, "other": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "observation": {"type": "object", "required": ["class", "instruction", "sufficient_by_itself", "runelite_boundary"], "properties": {"class": {"enum": ["quest_list", "inventory_or_equipment", "player_confirmation"]}, "instruction": {"type": "string", "minLength": 1}, "sufficient_by_itself": {"type": "boolean"}, "runelite_boundary": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "promotion": {"type": "object", "required": ["status", "reason"], "properties": {"status": {"enum": ["research_only", "eligible_for_milestone", "normalized_completion"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "checkpoint": {"type": "object", "required": ["id", "sequence", "state", "location", "description", "item_changes", "hazards", "observation", "promotion", "source_ids"], "properties": {"id": {"type": "string", "pattern": "^checkpoint:[a-z0-9][a-z0-9-]*$"}, "sequence": {"type": "integer", "minimum": 1}, "state": {"enum": ["start", "in_progress", "completion", "post_completion"]}, "location": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "item_changes": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "hazards": {"type": "array", "items": {"type": "string"}}, "observation": {"$ref": "#/$defs/observation"}, "promotion": {"$ref": "#/$defs/promotion"}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false},
    "completion": {"type": "object", "required": ["normalized_action_id", "rewards", "unlocks", "post_completion_claims"], "properties": {"normalized_action_id": {"type": ["string", "null"], "pattern": "^action:"}, "rewards": {"type": "array", "items": {"type": "string"}}, "unlocks": {"type": "array", "items": {"type": "string"}}, "post_completion_claims": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "boundaries": {"type": "object", "required": ["route_selected", "partial_progress_is_quest_completion", "action_auto_applied", "items_or_rewards_inferred", "lamp_target_selected", "survival_inferred"], "properties": {"route_selected": {"const": false}, "partial_progress_is_quest_completion": {"const": false}, "action_auto_applied": {"const": false}, "items_or_rewards_inferred": {"const": false}, "lamp_target_selected": {"const": false}, "survival_inferred": {"const": false}}, "additionalProperties": false}
  }
}
