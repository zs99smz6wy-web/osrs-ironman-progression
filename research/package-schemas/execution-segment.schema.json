{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zs99smz6wy-web/osrs-ironman-progression/research/package-schemas/execution-segment.schema.json",
  "title": "Research-only execution segment",
  "description": "A bounded, sourced itinerary below normalized actions. This contract records research evidence and player-observation checkpoints only; it cannot select a route, apply actions, acquire items, or assert outcomes.",
  "type": "object",
  "required": ["segment_schema_version", "segment_type", "segment_id", "name", "status", "purpose", "facts_strategy_boundary", "source_catalog", "source_ids", "starting_state", "checkpoints", "execution_steps", "branches", "safety_hcim", "passive_recurring_checks", "stop_reentry_conditions", "estimated_time", "completion_observations", "normalization_boundaries", "boundaries"],
  "properties": {
    "segment_schema_version": {"const": 1},
    "segment_type": {"const": "research-only-execution-segment"},
    "segment_id": {"type": "string", "pattern": "^segment:[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["research-proof", "research-template"]},
    "template": {"type": "boolean"},
    "purpose": {"$ref": "#/$defs/purpose"},
    "facts_strategy_boundary": {"$ref": "#/$defs/boundary"},
    "source_catalog": {"type": "array", "items": {"$ref": "#/$defs/source"}, "uniqueItems": true},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "starting_state": {"$ref": "#/$defs/startingState"},
    "checkpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/checkpoint"}},
    "execution_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "branches": {"type": "array", "items": {"$ref": "#/$defs/branch"}},
    "safety_hcim": {"$ref": "#/$defs/safety"},
    "passive_recurring_checks": {"type": "array", "items": {"$ref": "#/$defs/passiveCheck"}},
    "stop_reentry_conditions": {"$ref": "#/$defs/stopReentry"},
    "estimated_time": {"$ref": "#/$defs/time"},
    "completion_observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "normalization_boundaries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/normalizationBoundary"}},
    "boundaries": {"$ref": "#/$defs/boundary"}
  },
  "additionalProperties": false,
  "$defs": {
    "source": {"type": "object", "required": ["id", "url", "used_for", "verified_at"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "url": {"type": "string", "format": "uri"}, "used_for": {"type": "string", "minLength": 1}, "verified_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}, "additionalProperties": false},
    "purpose": {"type": "object", "required": ["accomplishes", "account_applicability", "timing_observation", "applicability_is_not_route_selection"], "properties": {"accomplishes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "account_applicability": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "timing_observation": {"type": "string", "minLength": 1}, "applicability_is_not_route_selection": {"const": true}}, "additionalProperties": false},
    "coverage": {"type": "object", "required": ["status", "fact_ids", "source_ids", "boundary"], "properties": {"status": {"enum": ["normalized_action", "sourced_unmodeled_substep", "unresolved"]}, "normalized_action_id": {"type": "string", "pattern": "^action:"}, "fact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "boundary": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "requirements": {"type": "object", "required": ["carried_items", "banked_items", "carried_gp", "banked_gp"], "properties": {"carried_items": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "banked_items": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "carried_gp": {"type": "integer", "minimum": 0}, "banked_gp": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "item": {"type": "object", "required": ["id", "quantity"], "properties": {"id": {"type": "string", "minLength": 1}, "quantity": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "startingState": {"type": "object", "required": ["assumptions", "requirements", "geographic_checkpoint", "bank_checkpoint"], "properties": {"assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "requirements": {"$ref": "#/$defs/requirements"}, "geographic_checkpoint": {"$ref": "#/$defs/checkpoint"}, "bank_checkpoint": {"$ref": "#/$defs/checkpoint"}}, "additionalProperties": false},
    "checkpoint": {"type": "object", "required": ["id", "kind", "description", "coverage"], "properties": {"id": {"type": "string", "pattern": "^(checkpoint|external):[a-z0-9][a-z0-9-]*$"}, "kind": {"enum": ["geographic", "bank", "external_partial_quest", "external_quest_completion", "player_observation"]}, "description": {"type": "string", "minLength": 1}, "coverage": {"$ref": "#/$defs/coverage"}}, "additionalProperties": false},
    "step": {"type": "object", "required": ["id", "sequence", "instruction", "coverage"], "properties": {"id": {"type": "string", "pattern": "^step:[a-z0-9][a-z0-9-]*$"}, "sequence": {"type": "integer", "minimum": 1}, "instruction": {"type": "string", "minLength": 1}, "coverage": {"$ref": "#/$defs/coverage"}, "checkpoint_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "additionalProperties": false},
    "branch": {"type": "object", "required": ["id", "when", "steps", "coverage"], "properties": {"id": {"type": "string", "pattern": "^branch:[a-z0-9][a-z0-9-]*$"}, "when": {"type": "string", "minLength": 1}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "coverage": {"$ref": "#/$defs/coverage"}}, "additionalProperties": false},
    "hazard": {"type": "object", "required": ["id", "description", "source_ids"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "additionalProperties": false},
    "safety": {"type": "object", "required": ["hazard_facts", "player_risk_requirements", "current_observations_required", "never_inferred_survival"], "properties": {"hazard_facts": {"type": "array", "items": {"$ref": "#/$defs/hazard"}}, "player_risk_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "current_observations_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "never_inferred_survival": {"const": true}}, "additionalProperties": false},
    "passiveCheck": {"type": "object", "required": ["id", "trigger_when", "required_current_observation", "interruption_policy", "source_ids"], "properties": {"id": {"type": "string", "minLength": 1}, "trigger_when": {"type": "string", "minLength": 1}, "required_current_observation": {"type": "string", "minLength": 1}, "interruption_policy": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "additionalProperties": false},
    "observation": {"type": "object", "required": ["id", "description", "source_ids"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "additionalProperties": false},
    "stopReentry": {"type": "object", "required": ["stop_conditions", "reentry_conditions"], "properties": {"stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "reentry_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "time": {"type": "object", "required": ["status", "source_ids", "uncertainty"], "properties": {"status": {"enum": ["not_estimated", "sourced_range"]}, "minutes_min": {"type": "integer", "minimum": 0}, "minutes_max": {"type": "integer", "minimum": 0}, "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "uncertainty": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "normalizationBoundary": {"type": "object", "required": ["normalized_action_id", "does_not_prove", "requires_separate_player_observation"], "properties": {"normalized_action_id": {"type": "string", "pattern": "^action:"}, "does_not_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "requires_separate_player_observation": {"const": true}}, "additionalProperties": false},
    "boundary": {"type": "object", "required": ["route_selected", "action_auto_applied", "completion_inferred", "items_or_gp_acquired", "outputs_inferred", "timing_inferred", "combat_success_inferred"], "properties": {"route_selected": {"const": false}, "action_auto_applied": {"const": false}, "completion_inferred": {"const": false}, "items_or_gp_acquired": {"const": false}, "outputs_inferred": {"const": false}, "timing_inferred": {"const": false}, "combat_success_inferred": {"const": false}}, "additionalProperties": false}
  }
}
