{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zs99smz6wy-web/osrs-ironman-progression/research/package-schemas/diary-package.schema.json",
  "title": "Achievement Diary Research Package Compatibility Contract",
  "description": "Research-only compatibility contract for regional Achievement Diary packages. It accepts the documented legacy layouts without rewriting them. It is not a production action, graph, or account-state schema. The companion validator resolves a task source either directly or through the explicit catalog-inheritance policy. Catalog inheritance supports regional factual research and tier-reward provenance only; it never authorizes automatic per-task production-action generation.",
  "type": "object",
  "required": ["status", "scope", "facts_strategy_boundary", "source_catalog"],
  "properties": {
    "package_schema_version": {"type": "integer", "minimum": 1},
    "package_type": {"type": "string"},
    "package_id": {"type": "string", "minLength": 1},
    "package": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "diary_name": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date"},
    "researched_at": {"type": "string", "format": "date"},
    "scope": {"type": "string", "minLength": 1},
    "facts_strategy_boundary": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "source_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tier"}
    },
    "tier_reward_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["tier"], "properties": {"tier": {"$ref": "#/$defs/tierName"}}, "additionalProperties": true}
    },
    "tier_rewards": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["tier"], "properties": {"tier": {"$ref": "#/$defs/tierName"}}, "additionalProperties": true}
    },
    "tier_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["tier"], "properties": {"tier": {"$ref": "#/$defs/tierName"}}, "additionalProperties": true}
    },
    "conflicts_and_unknowns": {"type": "array"},
    "unresolved_conflicts": {"type": "array"},
    "normalization_proposal": {"type": ["object", "array"]},
    "proposed_normalization": {"type": ["object", "array"]},
    "proposed_normalized_action_specs": {"type": ["object", "array"]},
    "proposed_graph": {"type": ["object", "array"]}
  },
  "allOf": [
    {"anyOf": [{"required": ["package_id"]}, {"required": ["package"]}]},
    {"anyOf": [{"required": ["checked_at"]}, {"required": ["researched_at"]}]},
    {"anyOf": [{"required": ["tasks"]}, {"required": ["tiers"]}]},
    {"anyOf": [{"required": ["tier_reward_claims"]}, {"required": ["tier_rewards"]}, {"required": ["tier_claims"]}, {"required": ["tiers"]}]},
    {"anyOf": [{"required": ["normalization_proposal"]}, {"required": ["proposed_normalization"]}, {"required": ["proposed_normalized_action_specs"]}, {"required": ["proposed_graph"]}]}
  ],
  "$defs": {
    "tierName": {"enum": ["easy", "medium", "hard", "elite"]},
    "source": {
      "type": "object",
      "required": ["id", "url", "checked_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "minLength": 1},
        "checked_at": {"type": "string", "format": "date"},
        "publisher": {"type": "string"},
        "kind": {"type": "string"},
        "type": {"type": "string"},
        "use": {"type": "string"},
        "coverage": {"type": "string"},
        "currentness_note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "tier": {"$ref": "#/$defs/tierName"},
        "task": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "anyOf": [{"required": ["task"]}, {"required": ["name"]}],
      "additionalProperties": true
    },
    "tier": {
      "type": "object",
      "required": ["tier", "tasks"],
      "properties": {
        "tier": {"$ref": "#/$defs/tierName"},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
        "reward": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
