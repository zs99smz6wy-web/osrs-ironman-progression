{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized progression action",
  "$defs": {
    "predicate": {
      "type": "object",
      "required": ["type", "key"],
      "properties": {
        "type": {
          "enum": [
            "skill_at_least",
            "quest_completed",
            "transport_flag",
            "milestone",
            "resource_at_least",
            "item_at_least",
            "counter_at_least",
            "passive_loop",
            "notable_drop",
            "gear_threshold"
          ]
        },
        "key": {"type": "string", "minLength": 1},
        "value": {"type": ["integer", "boolean"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/predicate"},
        {
          "type": "object",
          "required": ["all"],
          "properties": {
            "all": {"type": "array", "items": {"$ref": "#/$defs/condition"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": {
            "any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "outcome": {
      "type": "object",
      "required": ["type", "key"],
      "properties": {
        "type": {"enum": ["quest_completed", "transport_flag", "milestone", "passive_loop"]},
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["id", "name", "kind", "status", "fact_ids", "requirements", "preparation", "completion", "outcomes", "repeatable"],
  "properties": {
    "id": {"type": "string", "pattern": "^action:"},
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["quest", "unlock", "activity", "passive_setup"]},
    "status": {"const": "verified"},
    "fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "requirements": {"$ref": "#/$defs/condition"},
    "preparation": {"$ref": "#/$defs/condition"},
    "completion": {"$ref": "#/$defs/condition"},
    "outcomes": {"type": "array", "items": {"$ref": "#/$defs/outcome"}},
    "repeatable": {"type": "boolean"}
  },
  "additionalProperties": false
}
