{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized progression action",
  "$defs": {
    "predicate": {
      "type": "object",
      "required": ["type", "key"],
      "properties": {
        "type": {
          "enum": [
            "skill_at_least",
            "quest_completed",
            "transport_flag",
            "milestone",
            "resource_at_least",
            "item_at_least",
            "counter_at_least",
            "passive_loop",
            "afk_method_available",
            "afk_method_safety_acceptable",
            "combat_readiness_observed",
            "notable_drop",
            "gear_threshold"
          ]
        },
        "key": {"type": "string", "minLength": 1},
        "value": {"type": ["integer", "boolean"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/predicate"},
        {
          "type": "object",
          "required": ["all"],
          "properties": {
            "all": {"type": "array", "items": {"$ref": "#/$defs/condition"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": {
            "any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "outcome": {
      "type": "object",
      "required": ["type", "key"],
      "properties": {
        "type": {"enum": ["quest_completed", "transport_flag", "milestone", "passive_loop"]},
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "effect": {
      "oneOf": [
        {"type": "object", "required": ["op", "state", "key", "fact_id"], "properties": {"op": {"const": "set_add"}, "state": {"enum": ["quests_completed", "transport_flags", "milestones", "gear_thresholds", "notable_drops"]}, "key": {"type": "string", "minLength": 1}, "fact_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "state", "key", "value", "fact_id"], "properties": {"op": {"const": "set"}, "state": {"const": "passive_loops"}, "key": {"type": "string", "minLength": 1}, "value": {"type": "boolean"}, "fact_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "state", "key", "amount", "fact_id"], "properties": {"op": {"const": "delta"}, "state": {"enum": ["items", "resources", "counters"]}, "key": {"type": "string", "minLength": 1}, "amount": {"type": "integer", "not": {"const": 0}}, "fact_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "state", "key", "amount", "fact_id"], "properties": {"op": {"const": "gain_xp"}, "state": {"const": "skill_xp"}, "key": {"type": "string", "minLength": 1}, "amount": {"type": "integer", "minimum": 1}, "fact_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "state", "key", "value", "fact_id"], "properties": {"op": {"const": "ensure_min"}, "state": {"enum": ["items", "resources", "counters"]}, "key": {"type": "string", "minLength": 1}, "value": {"type": "integer", "minimum": 0}, "fact_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      ]
    },
    "reportedEffect": {
      "type": "object",
      "required": ["type", "fact_id"],
      "properties": {"type": {"enum": ["xp_award", "xp_choice_award", "claimable_reward", "recorded_progress", "variable_activity_output"]}, "skill": {"type": "string", "minLength": 1}, "amount": {"type": "integer", "minimum": 0}, "description": {"type": "string", "minLength": 1}, "fact_id": {"type": "string", "minLength": 1}},
      "allOf": [{"if": {"properties": {"type": {"const": "xp_award"}}}, "then": {"required": ["skill", "amount"]}}],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["id", "requires", "effects", "reported_effects"],
      "properties": {"id": {"type": "string", "minLength": 1}, "requires": {"$ref": "#/$defs/condition"}, "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "reported_effects": {"type": "array", "items": {"$ref": "#/$defs/reportedEffect"}}},
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["effects", "options", "reported_effects"],
      "properties": {"effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "options": {"type": "array", "items": {"$ref": "#/$defs/option"}, "uniqueItems": true}, "reported_effects": {"type": "array", "items": {"$ref": "#/$defs/reportedEffect"}}},
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["id", "name", "kind", "status", "fact_ids", "requirements", "preparation", "completion", "outcomes", "repeatable", "transition"],
  "properties": {
    "id": {"type": "string", "pattern": "^action:"},
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["quest", "unlock", "activity", "passive_setup"]},
    "status": {"const": "verified"},
    "fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "requirements": {"$ref": "#/$defs/condition"},
    "preparation": {"$ref": "#/$defs/condition"},
    "completion": {"$ref": "#/$defs/condition"},
    "outcomes": {"type": "array", "items": {"$ref": "#/$defs/outcome"}},
    "repeatable": {"type": "boolean"},
    "transition": {"$ref": "#/$defs/transition"}
  },
  "additionalProperties": false
}
